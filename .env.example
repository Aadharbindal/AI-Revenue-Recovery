# Copy to .env and fill in. Every value here is OPTIONAL.
#
# With an empty .env the demo still runs end to end: message bodies come from
# the deterministic fallback templates and payment links are simulated and
# flagged as such. A judge should never need our credentials to reproduce our
# numbers.

# ---------------------------------------------------------------- Razorpay
# Dashboard -> Test Mode -> Settings -> API Keys -> Generate Test Key.
# TEST MODE ONLY. A key starting with rzp_live_ must never go in this file.
RZP_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RZP_KEY_SECRET=

# ---------------------------------------------------------------- LLM
# Either one works; Groq is the default. Without a key the validator path is
# still exercised through the fallback, and `llm_used` reads false everywhere,
# which is the honest result rather than a hidden one.
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=groq/llama-3.3-70b-versatile

# ---------------------------------------------------------------- Voice
# Sarvam AI, used to render the Hinglish voice scripts as audio for the demo.
SARVAM_API_KEY=

# ---------------------------------------------------------------- Frontend
# Set in Vercel to the deployed backend URL.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api
